  "components": {
    "schemas": {
      "AccessSettings": {
        "properties": {
          "screen": {
            "type": "boolean",
            "title": "Screen",
            "default": true
          },
          "terminal": {
            "type": "boolean",
            "title": "Terminal",
            "default": true
          },
          "processes": {
            "type": "boolean",
            "title": "Processes",
            "default": true
          },
          "modify_files": {
            "type": "boolean",
            "title": "Modify Files",
            "default": false
          },
          "install_dependencies": {
            "type": "boolean",
            "title": "Install Dependencies",
            "default": false
          },
          "network": {
            "type": "boolean",
            "title": "Network",
            "default": false
          }
        },
        "type": "object",
        "title": "AccessSettings"
      },
      "AccessUpdate": {
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "screen",
              "terminal",
              "processes",
              "modify_files",
              "install_dependencies",
              "network"
            ],
            "title": "Capability"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "allowed"
        ],
        "title": "AccessUpdate"
      },
      "ActionResult": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "denied",
              "failed",
              "timeout"
            ],
            "title": "Status"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout",
            "default": ""
          },
          "stderr": {
            "type": "string",
            "title": "Stderr",
            "default": ""
          },
          "denial_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Denial Reason"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "action_id",
          "status",
          "duration_ms"
        ],
        "title": "ActionResult"
      },
      "Analysis": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "root_cause": {
            "type": "string",
            "title": "Root Cause"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "type": "array",
            "title": "Proposals"
          },
          "needed_context": {
            "items": {
              "type": "string",
              "enum": [
                "screen",
                "terminal",
                "processes"
              ]
            },
            "type": "array",
            "title": "Needed Context"
          },
          "context_reason": {
            "type": "string",
            "title": "Context Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "summary",
          "root_cause",
          "explanation",
          "confidence"
        ],
        "title": "Analysis"
      },
      "ContextRequest": {
        "properties": {
          "auto": {
            "type": "boolean",
            "title": "Auto",
            "default": true
          },
          "include_screen": {
            "type": "boolean",
            "title": "Include Screen",
            "default": true
          },
          "include_terminal": {
            "type": "boolean",
            "title": "Include Terminal",
            "default": true
          },
          "include_processes": {
            "type": "boolean",
            "title": "Include Processes",
            "default": false
          },
          "github": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GithubTarget"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ContextRequest"
      },
      "ContextSummary": {
        "properties": {
          "has_screenshot": {
            "type": "boolean",
            "title": "Has Screenshot"
          },
          "ocr_excerpt": {
            "type": "string",
            "title": "Ocr Excerpt"
          },
          "terminal_errors": {
            "items": {
              "$ref": "#/components/schemas/TerminalError"
            },
            "type": "array",
            "title": "Terminal Errors"
          },
          "pr_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pr Title"
          },
          "pr_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pr Files"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "has_screenshot",
          "ocr_excerpt"
        ],
        "title": "ContextSummary"
      },
      "CreateTaskRequest": {
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Command"
          },
          "context": {
            "$ref": "#/components/schemas/ContextRequest"
          }
        },
        "type": "object",
        "required": [
          "command"
        ],
        "title": "CreateTaskRequest"
      },
      "DecisionRequest": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
