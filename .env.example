# ============================================================================
# Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ============================================================================

# Model Integration (Nebius / Nemotron)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# Perception & GitHub Integration
GITHUB_TOKEN=your_github_token_here

# Security & Sandbox
# Shared secret between M2 (backend) and M1 (sandbox) for HMAC approval tokens
APPROVAL_SECRET=change-me-to-a-secure-random-hmac-secret-key-32-chars
# Root directory sandbox is permitted to operate inside
ALLOWED_ROOT=.

# Server & Integration Modes
# MOCK_MODE=1 enables canned responses and state machine walk-throughs for M3 testing
MOCK_MODE=1
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=http://localhost:5173
