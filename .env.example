# Keep all credentials in the backend; do not prefix them with VITE_.
ALLOWED_ROOT=./workspace
APPROVAL_SECRET=replace-with-a-random-local-secret
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GITHUB_TOKEN=
TESSERACT_PATH=
SANDBOX_IMAGE=prism-sandbox:local
ACTION_TIMEOUT_SECONDS=30
MODEL_TIMEOUT_SECONDS=90
SCREENSHOT_TTL_SECONDS=3600
TASK_TTL_SECONDS=3600
MAX_RETAINED_TASKS=100
HOST=127.0.0.1
PORT=8000
# STATE_DIR defaults to this installation's .prism directory, outside ALLOWED_ROOT.
# API_SESSION_TOKEN is generated per process. Do not save or copy it into a workspace.
